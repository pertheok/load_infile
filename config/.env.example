# Copy to config/.env and fill in. config/.env is gitignored - never commit it.
# Format: KEY=value (no quotes, no spaces around '='). Lines starting with # are ignored.

# ----- Production MySQL (PHP inserts + Python writers) -----
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=mds-current

# ----- Dev MySQL (includes/databaseDev.php) -----
DEV_DB_HOST=
DEV_DB_PORT=3306
DEV_DB_USER=
DEV_DB_PASS=
DEV_DB_NAME=mds-test

# ----- Alternate MySQL (DigitalOcean, currently unused) -----
DO_DB_HOST=
DO_DB_PORT=25060
DO_DB_USER=
DO_DB_PASS=
DO_DB_NAME=mds-current

# ----- Settlements -----
# Directory settlement ZIPs are extracted into
SETTLEMENTS_UNZIP_DIR=

# ----- FTP / orchestration (scripts/ftp.ps1) -----
WINSCP_DLL=
FTP_HOST=
FTP_USER=
FTP_CERT=
FTP_CERT_PASS=
REMOTE_PATH=
LOCAL_PATH=
MARKET_MESSAGE_SCRIPT=
SETTLEMENTS_SCRIPT=
SESSION_LOG=
DATA_TYPES=DCHVL,DISCH,DPIDS,ERRTRAN,LGUNR,MDPID,METER,MNETS,MRA,MSPID,NAPS,P1,R1,R2,R3,READS,RF,SSPID,SSSCO,TEADJ,TRCNCL,TRIF,UNPAIR,VLADJ,WSPID,WSSCO,msg
